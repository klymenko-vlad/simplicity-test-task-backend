{
  "name": "@simplicity-test-task/backend",
  "version": "0.1.0",
  "description": "Simplicity test task backend API \u2014 NestJS on Fastify with GraphQL (Mercurius)",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "db:check": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/database/seed.ts",
    "db:studio": "prisma studio",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --wait",
    "docker:up": "docker compose up -d --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graphql:check": "pnpm graphql:generate && git diff --exit-code -- src/schema.gql",
    "graphql:generate": "nest build -p tsconfig.build.json && node dist/generate-schema.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:cov && pnpm build && pnpm graphql:check"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.1",
    "@fastify/helmet": "^13.1.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/mercurius": "^13.2.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.16.3",
    "bullmq": "^6.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.0.0",
    "graphql": "^16.11.0",
    "ioredis": "^6.0.0",
    "mercurius": "^16.2.0",
    "mqemitter-redis": "^7.2.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.47",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-unicorn": "^61.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "tsx src/database/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": ">=9.7.0",
      "js-yaml@>=5.0.0": ">=5.2.2",
      "deepmerge-ts": ">=8.0.0",
      "uuid": ">=11.1.1"
    }
  }
}
